# =============================================================================
# vllm-multi-gpu-launcher — example configuration
#
# Copy this file to `.env` and adjust the values:
#
#     cp .env.example .env
#
# Every value can also be exported directly in your shell instead of using a
# `.env` file; shell `export` takes precedence. Quote values that contain
# spaces or shell special characters (use single quotes for the API key).
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------

# Absolute path to the model weights directory (or a Hugging Face repo id).
MODEL_PATH="/path/to/your/model"

# REQUIRED. The launcher refuses to start without this — it never runs an
# unauthenticated server. Use a strong random value with no whitespace.
VLLM_API_KEY='replace-with-a-strong-random-key'

# ---- SERVER -----------------------------------------------------------------

# Listening interface. Default 127.0.0.1 (localhost only). Set 0.0.0.0 only
# when you need remote access — an API key is still enforced either way.
#VLLM_HOST=127.0.0.1

# First port; instance i listens on BASE_PORT + i.
#VLLM_BASE_PORT=38000

# Space-separated model name(s) exposed via the OpenAI-compatible API.
# Default: the model directory's base name (no more gpt-4o/gpt-5 masquerade).
#VLLM_SERVED_MODEL_NAMES=""

# ---- MEMORY & BATCHING ------------------------------------------------------

# Fraction of GPU memory vLLM may use. Leave headroom for long contexts.
#VLLM_GPU_MEMORY_UTILIZATION=0.90

# Max concurrent sequences per instance (per GPU) in one batch.
#VLLM_MAX_NUM_SEQS=16

# Max context length (num positional embeddings). Set to your real
# "longest input + longest output", not "auto".
#VLLM_MAX_MODEL_LEN=40960

# Max tokens processed in a single forward step. With chunked prefill on,
# 2048–4096 is the sweet spot; larger values raise activation-memory / OOM
# risk and add decode latency jitter.
#VLLM_MAX_NUM_BATCHED_TOKENS=4096

# Quantization format. Leave EMPTY to let vLLM auto-detect (recommended —
# auto picks gptq_marlin etc.). Setting it to plain "gptq" can force the slow
# legacy kernel and tank throughput; prefer "gptq_marlin" if you set it.
#VLLM_QUANTIZATION=""

# ---- CPU THREAD CONTROL (the high-load fix) ---------------------------------

# Cap for the OpenMP / MKL low-level math libraries, in threads per instance.
# 4–8 is ideal for GPU-bound serving; do NOT scale this with your core count.
#VLLM_OMP_NUM_THREADS=8
#VLLM_MKL_NUM_THREADS=8

# Disable the tokenizer's implicit thread pool. Keep false for online serving.
#VLLM_TOKENIZERS_PARALLELISM=false

# ---- FEATURES ---------------------------------------------------------------

# 1 = enable (default), 0 = disable.
#VLLM_ENABLE_PREFIX_CACHING=1
#VLLM_ENABLE_CHUNKED_PREFILL=1

# ---- MODEL-SPECIFIC FLAGS (off by default; enable only for matching models) -
# Qwen3 example (uncomment all three for a Qwen3 tool-calling deployment):
#VLLM_REASONING_PARSER=qwen3
#VLLM_TOOL_CALL_PARSER=hermes
#VLLM_ENABLE_AUTO_TOOL_CHOICE=1

# ---- PATHS ------------------------------------------------------------------

# Log directory (one file per GPU) and PID directory (for stop_vllm.sh).
#VLLM_LOG_DIR=./vllm_logs
#VLLM_RUN_DIR=./vllm_run

# Health-check timeout in seconds (model load usually takes ~60s).
#VLLM_HEALTH_TIMEOUT=180

# Optional Python virtualenv to activate before launching.
#VENV_DIR=./.venv